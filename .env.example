# ================================
# JARVIS - Personalized AI Configuration
# ================================

# === LLM Settings ===
LLM_PROVIDER=deepseek              # Options: deepseek, openai, ollama
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama (alternative, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# === LEANN (RAG) Settings ===
EMBEDDING_MODEL=facebook/contriever
EMBEDDING_DEVICE=cuda              # Options: cuda, cpu
TOP_K=5                            # Number of results to retrieve
CHUNK_SIZE=512                     # Document chunk size
CHUNK_OVERLAP=50                   # Overlap between chunks
SIMILARITY_THRESHOLD=0.5           # Min score for relevant results (0.0-1.0)

# === Web Search Settings ===
WEB_SEARCH_ENABLED=true            # Enable web fallback when docs insufficient
BRAVE_API_KEY=your_brave_key_here
WEB_SEARCH_MAX_RESULTS=3           # Max web results to use

# === Voice Settings (ASR) ===
ASR_ENABLED=false                  # Enable voice input (set true when ready)
ASR_MODEL=omniASR_CTC_1B          # Omnilingual ASR model
ASR_DEVICE=cuda
ASR_LANGUAGE=auto                  # Options: auto, eng_Latn, spa_Latn, etc.

# === Voice Settings (TTS) ===
TTS_ENABLED=false                  # Enable voice output (set true when ready)
TTS_MODEL=xtts_v2                  # Coqui XTTS-v2
TTS_DEVICE=cuda
TTS_LANGUAGE=en                    # Options: en, es, fr, de, it, pt, etc.
TTS_STREAMING=true                 # Enable streaming output
TTS_SPEAKER_WAV=                   # Optional: path to custom voice sample

# === Storage Settings ===
USERS_DIR=users                    # Directory for user data
MAX_UPLOAD_SIZE_MB=50              # Max file upload size

# === System Settings ===
LOG_LEVEL=INFO                     # Options: DEBUG, INFO, WARNING, ERROR
GPU_BATCH_SIZE=32                  # Batch size for GPU operations
